<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper Engine" Width="1100" Height="900" MinWidth="900" MinHeight="760"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#14243D"/>
    <SolidColorBrush x:Key="Muted" Color="#61718A"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE4EF"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE4EF"/>
      <Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#175CD3"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#EAF0FC"/><Setter Property="Foreground" Value="#175CD3"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,20,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Border Background="#F3F6FB" CornerRadius="16">
  <Grid Margin="26,22,26,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="WindowDragRegion" Background="Transparent" ToolTip="拖动标题或界面空白处移动窗口；双击标题最大化或还原">
        <DockPanel>
          <Image x:Name="HeaderIcon" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="Wallpaper Engine" FontSize="27" FontWeight="Bold"/>
        </DockPanel>
        <TextBlock Text="实时转写 · 仅两分钟回答 · 拖动标题或空白处移动" FontSize="11" Foreground="#175CD3" Margin="1,6,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Width="150" Margin="0,0,18,0" VerticalAlignment="Center">
          <TextBlock x:Name="OpacityLabel" Text="不透明度 86%" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,5"/>
          <Slider x:Name="OpacitySlider" Minimum="40" Maximum="100" Value="86" TickFrequency="1" IsSnapToTickEnabled="True"/>
        </StackPanel>
        <Button x:Name="PinButton" Content="窗口置顶" Style="{StaticResource Secondary}" Margin="0,0,10,0"/>
        <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource Secondary}"/>
        <Button x:Name="MinimizeButton" Content="−" Style="{StaticResource Secondary}" Padding="10,8" Margin="8,0,0,0" ToolTip="最小化"/>
        <Button x:Name="CloseWindowButton" Content="×" Style="{StaticResource Secondary}" Padding="10,8" Margin="6,0,0,0" ToolTip="退出"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#E8F5F0" BorderBrush="#CBE8DC" BorderThickness="1" CornerRadius="10" Margin="0,18,0,18" Padding="14,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ProtectionTitle" Text="正在启用共享保护…" Foreground="#17684E" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProtectionDetail" Text="腾讯会议接收端效果待验证。共享前，请通过另一台设备确认画面。" Foreground="#4C7364" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="CheckProtectionButton" Grid.Column="1" Content="检查状态" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" Padding="12,8"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid x:Name="InterviewPanel">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="16" Padding="22">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="0.8*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="01  扬声器连续识别" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="StartButton" Content="▶  开始" Padding="22,10"/>
              <Button x:Name="StopButton" Content="■  停止" Style="{StaticResource Secondary}" Padding="22,10" Margin="10,0,0,0" IsEnabled="False"/>
              <CheckBox x:Name="AutoAnswerBox" Content="自动识别问题并回答" IsChecked="True" FontSize="11" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="SpeechStatus" Grid.Row="2" Text="未开始 · 只采集默认输出设备，不采集麦克风。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10"/>
            <Grid Grid.Row="3">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="TranscriptBox" IsReadOnly="True" AcceptsReturn="True" FontSize="14" MinHeight="100"/>
              <TextBlock x:Name="TranscriptPreviewText" Grid.Row="1" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" MaxHeight="58" Margin="0,6,0,0"/>
            </Grid>
            <DockPanel Grid.Row="4" Margin="0,8,0,12">
              <Button x:Name="UseTranscriptButton" DockPanel.Dock="Right" Content="使用选中 / 最新文字" Style="{StaticResource Secondary}" Padding="10,6" FontSize="11"/>
              <TextBlock Text="停顿后自动回答" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Grid.Row="5" Text="当前问题 · 可编辑" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="QuestionBox" Grid.Row="6" AcceptsReturn="True" MinHeight="75" MaxLength="8000" FontSize="15"/>
            <Button x:Name="GenerateButton" Grid.Row="7" Content="重新生成当前答案" Style="{StaticResource Secondary}" Padding="8,12" Margin="0,12,0,0"/>
            <Button x:Name="CancelButton" Grid.Row="8" Content="取消生成" Style="{StaticResource Secondary}" Margin="0,8,0,0" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="22">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel>
              <Button x:Name="CopyButton" Content="复制" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Padding="12,6" IsEnabled="False"/>
              <TextBlock Text="02  参考回答" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="AnswerContext" Grid.Row="1" Text="点击开始后，自动识别完整问题并显示参考答案。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,15"/>
            <TextBox x:Name="AnswerBox" Grid.Row="2" IsReadOnly="True" Text="你的参考答案会显示在这里。" FontSize="16" BorderThickness="0" Background="White" Padding="0" AcceptsReturn="True"/>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="SettingsPanel" Background="White" CornerRadius="16" Padding="24" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="个人设置" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="模型：DeepSeek V4.1 Flash（deepseek-flash）" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
            <TextBlock Text="回答模板：interview-answer-templates · 仅 2 分钟版" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="DeepSeek API Key" Margin="0,0,0,7"/>
            <PasswordBox x:Name="ApiKeyBox" MaxLength="512"/>
            <CheckBox x:Name="RememberKeyBox" Content="在本机记住密钥（Windows 加密）" IsChecked="True"/>
            <TextBlock Text="识别词汇提示（可选，点击下一次开始时生效）" Margin="0,10,0,7"/>
            <TextBox x:Name="VocabularyBox" Height="65" AcceptsReturn="True" MaxLength="1500"/>
            <TextBlock Text="填写常用中英文术语，如 Spring Boot、Redis、dependency injection；有助于术语识别。语音在本机处理。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,4"/>
            <TextBlock Text="岗位 JD（可选）" Margin="0,10,0,7"/>
            <TextBox x:Name="JobBox" Height="94" AcceptsReturn="True" MaxLength="20000"/>
            <TextBlock Text="简历摘要（可选）" Margin="0,15,0,7"/>
            <TextBox x:Name="ResumeBox" Height="94" AcceptsReturn="True" MaxLength="20000"/>
            <WrapPanel Margin="0,6,0,6">
              <CheckBox x:Name="TopmostBox" Content="窗口始终置顶"/>
              <CheckBox x:Name="HideTaskbarBox" Content="隐藏任务栏入口（从托盘恢复）"/>
            </WrapPanel>
            <TextBlock Text="自动回答开启时，合并后的转写文字、岗位 JD 和简历摘要会发送给 DeepSeek，以判断问题并回答。语音仍在本地识别。设置保存在程序旁的 MockInterviewAI-data 文件夹。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Button x:Name="SaveSettingsButton" Content="保存设置" HorizontalAlignment="Left" MinWidth="150"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="2,16,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
      <TextBlock Grid.Column="1" Text="模拟面试训练 · AI 回答请核对" Foreground="#8896AA" FontSize="11" Margin="16,0,0,0"/>
    </Grid>
  </Grid>
  </Border>
</Window>
